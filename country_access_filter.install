<?php

/**
 * @file
 * Install, update, and uninstall functions for the module.
 */

use Drupal\country_access_filter\AccessMode;

/**
 * Implements hook_schema().
 *
 * @return array
 *   The schema definitions for the module's database tables.
 */
function country_access_filter_schema(): array {
  $schema = [];

  $schema['country_access_filter_ips'] = [
    'description' => 'Table for storing IP addresses and their access.',
    'fields' => [
      'ip' => [
        'description' => 'Packed IPv4 or IPv6 address.',
        'type' => 'blob',
        'not null' => TRUE,
        'mysql_type' => 'VARBINARY(16)',
        'pgsql_type' => 'BYTEA',
        'sqlite_type' => 'BLOB',
      ],
      'access' => [
        'description' => 'IP address access. Allowed - 1, denied - 0.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
      ],
      'access_locked' => [
        'description' => 'Whether the access decision is independent of country rules.',
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'country_code' => [
        'description' => 'The ISO 3166-1 alpha-2 country code.',
        'type' => 'char',
        'length' => 2,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['ip'],
    'indexes' => [
      'country_code' => ['country_code'],
    ],
  ];

  $schema['country_access_404_tracker'] = [
    'description' => 'Track IP addresses that triggered 404 responses.',
    'fields' => [
      'ip' => [
        'description' => 'Packed IPv4 or IPv6 address.',
        'type' => 'blob',
        'not null' => TRUE,
        'mysql_type' => 'VARBINARY(16)',
        'pgsql_type' => 'BYTEA',
        'sqlite_type' => 'BLOB',
      ],
      'first_404' => [
        'description' => 'Timestamp of the first 404 in current window.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'count' => [
        'description' => 'Number of 404s in current window.',
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 1,
      ],
    ],
    'primary key' => ['ip'],
    'indexes' => [
      'first_404' => ['first_404'],
    ],
  ];

  return $schema;
}

/**
 * Adds the IP country code field and its index.
 */
function country_access_filter_update_10001(): void {
  $table = 'country_access_filter_ips';
  $field = 'country_code';
  $index_name = $field;
  $spec = country_access_filter_schema()[$table] ?? FALSE;

  $connection = Drupal::database();
  $schema = $connection->schema();

  if (
    !empty($spec['fields'][$field])
    && !$schema->fieldExists($table, $field)
  ) {
    // Clear records because they are unusable without a country code.
    $connection->truncate($table)->execute();

    $schema->addField($table, $field, $spec['fields'][$field]);
  }

  if (
    !empty($spec['indexes'][$index_name])
    && !$schema->indexExists($table, $index_name)
  ) {
    $schema->addIndex($table, $index_name, $spec['indexes'][$index_name], $spec);
  }
}

/**
 * Creates the table used to track repeated 404 responses.
 */
function country_access_filter_update_10002(): void {
  $table = 'country_access_404_tracker';
  $spec = country_access_filter_schema()[$table];
  $schema = Drupal::database()->schema();

  if (!$schema->tableExists($table)) {
    $schema->createTable($table, $spec);
  }
}

/**
 * Removes the obsolete debug mode setting from module configuration.
 */
function country_access_filter_update_10003(): void {
  Drupal::configFactory()
    ->getEditable('country_access_filter.settings')
    ->clear('debug_mode')
    ->save();
}

/**
 * Adds default settings for 404 tracking.
 */
function country_access_filter_update_10004(): void {
  $config = Drupal::configFactory()
    ->getEditable('country_access_filter.settings');
  $data = $config->getRawData();
  $changed = FALSE;

  $defaults = [
    'track_404' => FALSE,
    'track_404_threshold' => 5,
    'track_404_window' => 1,
  ];

  foreach ($defaults as $key => $value) {
    if (!array_key_exists($key, $data)) {
      $config->set($key, $value);
      $changed = TRUE;
    }
  }

  if ($changed) {
    $config->save();
  }
}

/**
 * Adds the country access mode to module configuration.
 */
function country_access_filter_update_10005(): void {
  Drupal::configFactory()
    ->getEditable('country_access_filter.settings')
    ->set('country_access_mode', AccessMode::ALLOW->value)
    ->save();
}

/**
 * Converts the 404 tracking window from hours to seconds.
 */
function country_access_filter_update_10006(): void {
  $config = Drupal::configFactory()
    ->getEditable('country_access_filter.settings');
  $window = $config->get('track_404_window');

  if (is_numeric($window)) {
    $config
      ->set('track_404_window', (int) $window * 3600)
      ->save();
  }
}

/**
 * Converts stored IP addresses to packed binary values in batches.
 *
 * @param array $sandbox
 *   Stores progress between update batches.
 *
 * @return void
 *   No return value. Sets $sandbox['#finished'] to the batch progress.
 */
function country_access_filter_update_10007(&$sandbox): void {
  $database = Drupal::database();
  $schema = $database->schema();

  $table = 'country_access_filter_ips';
  $main_field = 'ip';
  $temporary_field = 'ip_packed';
  $chunk_size = 1000;

  if (PHP_INT_SIZE < 8) {
    throw new RuntimeException('The IP migration requires a 64-bit PHP build.');
  }

  if (!isset($sandbox['initialized'])) {
    if (!$schema->fieldExists($table, $temporary_field)) {
      $schema->addField($table, $temporary_field, [
        'description' => 'Temporary packed IPv4 address.',
        'type' => 'blob',
        'not null' => FALSE,
        'mysql_type' => 'VARBINARY(16)',
        'pgsql_type' => 'BYTEA',
        'sqlite_type' => 'BLOB',
      ]);
    }

    $sandbox['total'] = (int) $database
      ->select($table)
      ->countQuery()
      ->execute()
      ->fetchField();

    $sandbox['processed'] = 0;
    $sandbox['initialized'] = TRUE;
  }

  $query = $database
    ->select($table, 'i')
    ->fields('i', [$main_field])
    ->isNull($temporary_field)
    ->orderBy($main_field)
    ->range(0, $chunk_size);

  $processed_this_pass = 0;

  foreach ($query->execute() as $record) {
    $database
      ->update($table)
      ->fields([
        $temporary_field => pack('N', (int) $record->ip),
      ])
      ->condition($main_field, $record->ip)
      ->execute();

    $sandbox['processed']++;
    $processed_this_pass++;
  }

  if ($processed_this_pass > 0) {
    $total = max(1, $sandbox['total']);

    // Keep one final pass for replacing the primary key.
    $sandbox['#finished'] = min(0.99, $sandbox['processed'] / $total);

    return;
  }

  $database->delete($table)
    ->isNull($temporary_field)
    ->execute();

  $schema->dropPrimaryKey($table);
  $schema->dropField($table, $main_field);

  $schema->changeField(
    $table,
    $temporary_field,
    $main_field,
    [
      'description' => 'Packed IPv4 or IPv6 address.',
      'type' => 'blob',
      'not null' => TRUE,
      'mysql_type' => 'VARBINARY(16)',
      'pgsql_type' => 'BYTEA',
      'sqlite_type' => 'BLOB',
    ],
    [
      'primary key' => [$main_field],
    ],
  );

  $sandbox['#finished'] = 1;
}

/**
 * Converts tracked IP addresses to packed binary values in batches.
 *
 * @param array $sandbox
 *   Stores progress between update batches.
 *
 * @return void
 *   No return value. Sets $sandbox['#finished'] to the batch progress.
 */
function country_access_filter_update_10008(&$sandbox): void {
  $database = Drupal::database();
  $schema = $database->schema();

  $table = 'country_access_404_tracker';
  $main_field = 'ip';
  $temporary_field = 'ip_packed';
  $chunk_size = 1000;

  if (PHP_INT_SIZE < 8) {
    throw new RuntimeException('The IP migration requires a 64-bit PHP build.');
  }

  if (!isset($sandbox['initialized'])) {
    if (!$schema->fieldExists($table, $temporary_field)) {
      $schema->addField($table, $temporary_field, [
        'description' => 'Temporary packed IPv4 address.',
        'type' => 'blob',
        'not null' => FALSE,
        'mysql_type' => 'VARBINARY(16)',
        'pgsql_type' => 'BYTEA',
        'sqlite_type' => 'BLOB',
      ]);
    }

    $sandbox['total'] = (int) $database
      ->select($table)
      ->countQuery()
      ->execute()
      ->fetchField();

    $sandbox['processed'] = 0;
    $sandbox['initialized'] = TRUE;
  }

  $query = $database
    ->select($table, 'i')
    ->fields('i', [$main_field])
    ->isNull($temporary_field)
    ->orderBy($main_field)
    ->range(0, $chunk_size);

  $processed_this_pass = 0;

  foreach ($query->execute() as $record) {
    $database
      ->update($table)
      ->fields([
        $temporary_field => pack('N', (int) $record->ip),
      ])
      ->condition($main_field, $record->ip)
      ->execute();

    $sandbox['processed']++;
    $processed_this_pass++;
  }

  if ($processed_this_pass > 0) {
    $total = max(1, $sandbox['total']);

    // Keep one final pass for replacing the primary key.
    $sandbox['#finished'] = min(0.99, $sandbox['processed'] / $total);

    return;
  }

  $database->delete($table)
    ->isNull($temporary_field)
    ->execute();

  $schema->dropPrimaryKey($table);
  $schema->dropField($table, $main_field);

  $schema->changeField(
    $table,
    $temporary_field,
    $main_field,
    [
      'description' => 'Packed IPv4 or IPv6 address.',
      'type' => 'blob',
      'not null' => TRUE,
      'mysql_type' => 'VARBINARY(16)',
      'pgsql_type' => 'BYTEA',
      'sqlite_type' => 'BLOB',
    ],
    [
      'primary key' => [$main_field],
    ],
  );

  $sandbox['#finished'] = 1;
}

/**
 * Renames the IP access field from status to access.
 */
function country_access_filter_update_10009(): void {
  $schema = Drupal::database()->schema();
  $table = 'country_access_filter_ips';
  $old_name = 'status';
  $new_name = 'access';
  $spec = country_access_filter_schema()[$table]['fields'][$new_name] ?? FALSE;

  if (
    !$spec
    || !$schema->fieldExists($table, $old_name)
    || $schema->fieldExists($table, $new_name)
  ) {
    return;
  }

  $schema->changeField($table, $old_name, $new_name, $spec);
}

/**
 * Locks existing IP decisions that differ from the current country policy.
 */
function country_access_filter_update_10010(): void {
  $database = Drupal::database();
  $table = 'country_access_filter_ips';
  $schema = $database->schema();

  if (!$schema->fieldExists($table, 'access_locked')) {
    $schema->addField($table, 'access_locked', country_access_filter_schema()[$table]['fields']['access_locked']);
  }

  // Infer existing exceptions without changing their access or country.
  $config = Drupal::config('country_access_filter.settings');
  $selected = preg_split('/\s+/', trim((string) $config->get('countries')), -1, PREG_SPLIT_NO_EMPTY);
  $allowed = $config->get('country_access_mode') === AccessMode::ALLOW->value
    ? $selected
    : array_diff(array_keys(Drupal::service('country_manager')
      ->getList()), $selected);

  if ($allowed) {
    $database->update($table)
      ->fields(['access_locked' => 1])
      ->condition('country_code', $allowed, 'IN')
      ->condition('access', 0)
      ->execute();
  }

  $query = $database->update($table)
    ->fields(['access_locked' => 1])
    ->condition('access', 1);

  if ($allowed) {
    $query->condition('country_code', $allowed, 'NOT IN');
  }

  $query->execute();
}

/**
 * Removes legacy unknown-country IPs and their stale 404 counters.
 */
function country_access_filter_update_10011(): void {
  $database = Drupal::database();
  $transaction = $database->startTransaction();

  try {
    // Historical autobans overwrote the country with XX. Forget these decisions
    // so the next request resolves the country again, including legitimate XX.
    $unknown_ips = $database->select('country_access_filter_ips', 'i')
      ->fields('i', ['ip'])
      ->condition('country_code', 'XX');
    $database->delete('country_access_404_tracker')
      ->condition('ip', $unknown_ips, 'IN')
      ->execute();
    $database->delete('country_access_filter_ips')
      ->condition('country_code', 'XX')
      ->execute();
  }
  catch (\Throwable $exception) {
    $transaction->rollBack();

    throw $exception;
  }
}
